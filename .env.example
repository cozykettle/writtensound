# Copy to .env and adjust. All values are optional.
WS_DATA_DIR=./data
WS_PORT=8080
APP_PASSWORD=
HF_TOKEN=
WS_LOG_LEVEL=INFO
PUID=99
PGID=100
WS_MAX_UPLOAD_BYTES=17179869184
WS_ENABLE_DEMO_ENGINE=1

# Engine source pins. The Dockerfile has matching defaults; uncomment only to
# override them. Keep backend/engines/*/args.py in sync when changing a tag.
# WHISPERCPP_TAG=v1.9.5
# NEMOSPEECH_TAG=v0.2.0
# CUDA_VERSION=12.8.1
# Optional single-GPU CUDA build target. `75` is a T600; omit for the release
# fat image covering 75;80;86;89;90;120.
# CUDA_ARCHITECTURES=75

# Select the CUDA service at run time with:
#   docker compose --profile cuda up -d --build writtensound-cuda
