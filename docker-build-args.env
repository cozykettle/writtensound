# Engine source pins. Keep these in sync with backend/engines/*/args.py in the
# same change that updates an adapter. Never point these at main/master.
WHISPERCPP_TAG=v1.9.5
NEMOSPEECH_TAG=v0.2.0

# CUDA base image. Ubuntu 24.04 is required so the standard and CUDA images
# share the Python 3.12 runtime contract.
CUDA_VERSION=12.8.1

# CUDA fatbin targets. Override with a single value (for example 75 for a
# T600) when building a local image for one GPU.
CUDA_ARCHITECTURES="75;80;86;89;90;120"
